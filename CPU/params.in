# ===============================
# 以下为求解器可选输出配置（key=value）
# 不影响前面物理参数读取，可按实验需要开启/关闭
# 最小诊断版建议：
# 1. 保留每步摘要 CSV
# 2. 关闭整场 CSV，避免文件过大
# 3. 终端只保留两类告警：负密度、NaN/Inf
# ===============================
enable_timing=1               # 是否在终端输出总耗时、平均每步耗时
enable_progress=1             # 是否在终端显示当前进度和预计剩余时间
enable_tecplot_output=1       # 是否按 output_frequency 生成 Tecplot 二进制结果文件
enable_debug_field_csv=0      # 是否按 output_frequency 生成整场 CSV；文件很大，通常只在小规模调试时开启
enable_step_summary_csv=1     # 是否每一步都生成一条场统计摘要，写入 step_diagnostics.csv
enable_basic_warnings=1       # 是否在终端提示两类基础异常：首次出现负密度、首次出现 NaN/Inf
output_dir=out/               # 输出目录；所有诊断文件和结果文件都会写到这里
step_summary_filename=step_diagnostics.csv  # 每步统计摘要文件名
